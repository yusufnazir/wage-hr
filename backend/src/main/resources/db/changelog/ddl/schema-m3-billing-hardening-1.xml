<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m3-billing-provider-link-unique-customer-1" author="wagepayroll">
        <addUniqueConstraint tableName="billing_provider_link" columnNames="provider,external_customer_id"
                             constraintName="ux_billing_provider_link_provider_customer"/>
    </changeSet>

    <changeSet id="schema-m3-billing-webhook-receipt-tenant-1" author="wagepayroll">
        <addColumn tableName="billing_webhook_receipt">
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <addForeignKeyConstraint baseTableName="billing_webhook_receipt" baseColumnNames="tenant_id"
                                 constraintName="fk_billing_webhook_receipt_tenant" referencedTableName="tenant"
                                 referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>
</databaseChangeLog>
