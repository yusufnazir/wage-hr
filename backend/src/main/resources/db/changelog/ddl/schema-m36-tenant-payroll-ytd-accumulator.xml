<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m36-tenant-payroll-ytd-accumulator-1" author="wagepayroll">
        <createTable tableName="tenant_payroll_ytd_accumulator">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="tax_year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="accumulator_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_iso3" type="CHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="tenant_payroll_ytd_accumulator"
                             columnNames="tenant_id, employee_id, tax_year, accumulator_code"
                             constraintName="uk_tenant_payroll_ytd_accumulator"/>
        <createIndex indexName="idx_tenant_payroll_ytd_accumulator_tenant_employee_year"
                     tableName="tenant_payroll_ytd_accumulator">
            <column name="tenant_id"/>
            <column name="employee_id"/>
            <column name="tax_year"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
