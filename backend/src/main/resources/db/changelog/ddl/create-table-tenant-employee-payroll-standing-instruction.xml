<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m19-tenant-employee-payroll-standing-instruction-1" author="wagepayroll">
        <createTable tableName="tenant_employee_payroll_standing_instruction">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_wage_component_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="effective_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="effective_to" type="DATE"/>
            <column name="amount" type="DECIMAL(19,4)"/>
            <column name="quantity" type="DECIMAL(19,4)"/>
            <column name="rate" type="DECIMAL(19,4)"/>
            <column name="recurrence" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="remarks" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_tepsi_company"
                                 baseTableName="tenant_employee_payroll_standing_instruction"
                                 baseColumnNames="company_id,tenant_id"
                                 referencedTableName="tenant_company" referencedColumnNames="id,tenant_id"/>
        <addForeignKeyConstraint constraintName="fk_tepsi_employee"
                                 baseTableName="tenant_employee_payroll_standing_instruction"
                                 baseColumnNames="employee_id,company_id,tenant_id"
                                 referencedTableName="tenant_employee" referencedColumnNames="id,company_id,tenant_id"/>
        <addForeignKeyConstraint constraintName="fk_tepsi_component"
                                 baseTableName="tenant_employee_payroll_standing_instruction"
                                 baseColumnNames="tenant_wage_component_id"
                                 referencedTableName="tenant_wage_component" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="schema-m19-tenant-employee-payroll-standing-instruction-idx-1" author="wagepayroll">
        <createIndex indexName="idx_tepsi_tenant_employee_component"
                     tableName="tenant_employee_payroll_standing_instruction">
            <column name="tenant_id"/>
            <column name="employee_id"/>
            <column name="tenant_wage_component_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="schema-m19-twct-unique-period-employee-component-1" author="wagepayroll">
        <addUniqueConstraint constraintName="uq_twct_tenant_period_employee_component"
                             tableName="tenant_wage_component_transaction"
                             columnNames="tenant_id,pay_period_id,employee_id,tenant_wage_component_id"/>
    </changeSet>

</databaseChangeLog>
