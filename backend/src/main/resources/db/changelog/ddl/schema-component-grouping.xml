            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="platform_component_group_locale"
                                 baseColumnNames="platform_component_group_id"
                                 constraintName="fk_platform_component_group_locale_group"
                                 referencedTableName="platform_component_group"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="platform_component_group_locale"
                             columnNames="platform_component_group_id,locale"
                             constraintName="uk_platform_component_group_locale"/>
        <createIndex indexName="idx_platform_component_group_locale_group" tableName="platform_component_group_locale">
            <column name="platform_component_group_id"/>
        </createIndex>
    </changeSet>

