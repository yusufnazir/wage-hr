<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Rename M26 platform component grouping tables to *template* naming (idempotent). -->
    <changeSet id="schema-m27-drop-fks-platform-component-grouping" author="wagepayroll">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES
                    WHERE UPPER(TABLE_NAME) = 'PLATFORM_COMPONENT_GROUP'
                </sqlCheck>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES
                    WHERE UPPER(TABLE_NAME) = 'PLATFORM_COMPONENT_GROUP_TEMPLATE'
                </sqlCheck>
            </and>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="platform_component_item_locale" constraintName="fk_platform_component_item_locale_item"/>
        <dropForeignKeyConstraint baseTableName="platform_component_item" constraintName="fk_platform_component_item_header"/>
        <dropForeignKeyConstraint baseTableName="platform_component_item" constraintName="fk_platform_component_item_wage_component"/>
        <dropForeignKeyConstraint baseTableName="platform_component_header_locale" constraintName="fk_platform_component_header_locale_header"/>
        <dropForeignKeyConstraint baseTableName="platform_component_header" constraintName="fk_platform_component_header_group"/>
        <dropForeignKeyConstraint baseTableName="platform_component_group_locale" constraintName="fk_platform_component_group_locale_group"/>
        <dropForeignKeyConstraint baseTableName="platform_component_group" constraintName="fk_platform_component_group_country"/>
    </changeSet>

    <changeSet id="schema-m27-drop-uks-platform-component-grouping" author="wagepayroll">
        <preConditions onFail="MARK_RAN">
