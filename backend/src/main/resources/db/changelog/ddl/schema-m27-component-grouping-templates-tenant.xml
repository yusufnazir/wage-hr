            </and>
        </preConditions>
        <renameTable oldTableName="platform_component_group" newTableName="platform_component_group_template"/>
        <renameTable oldTableName="platform_component_group_locale" newTableName="platform_component_group_template_locale"/>
        <renameTable oldTableName="platform_component_header" newTableName="platform_component_header_template"/>
        <renameTable oldTableName="platform_component_header_locale" newTableName="platform_component_header_template_locale"/>
        <renameTable oldTableName="platform_component_item" newTableName="platform_component_item_template"/>
        <renameTable oldTableName="platform_component_item_locale" newTableName="platform_component_item_template_locale"/>
    </changeSet>

    <changeSet id="schema-m27-rename-columns-platform-component-grouping" author="wagepayroll">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES
                    WHERE UPPER(TABLE_NAME) = 'PLATFORM_COMPONENT_GROUP_TEMPLATE_LOCALE'
                </sqlCheck>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
                    WHERE UPPER(TABLE_NAME) = 'PLATFORM_COMPONENT_GROUP_TEMPLATE_LOCALE'
                    AND UPPER(COLUMN_NAME) = 'PLATFORM_COMPONENT_GROUP_ID'
                </sqlCheck>
            </and>
        </preConditions>
        <renameColumn tableName="platform_component_group_template_locale"
                      oldColumnName="platform_component_group_id"
                      newColumnName="platform_component_group_template_id"
                      columnDataType="VARCHAR(36)"/>
        <renameColumn tableName="platform_component_header_template"
                      oldColumnName="platform_component_group_id"
                      newColumnName="platform_component_group_template_id"
                      columnDataType="VARCHAR(36)"/>
        <renameColumn tableName="platform_component_header_template_locale"
                      oldColumnName="platform_component_header_id"
                      newColumnName="platform_component_header_template_id"
                      columnDataType="VARCHAR(36)"/>
        <renameColumn tableName="platform_component_item_template"
                      oldColumnName="platform_component_header_id"
                      newColumnName="platform_component_header_template_id"
                      columnDataType="VARCHAR(36)"/>
        <renameColumn tableName="platform_component_item_template_locale"
                      oldColumnName="platform_component_item_id"
                      newColumnName="platform_component_item_template_id"
                      columnDataType="VARCHAR(36)"/>
    </changeSet>

    <changeSet id="schema-m27-recreate-fks-uks-platform-component-grouping" author="wagepayroll">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES
                    WHERE UPPER(TABLE_NAME) = 'PLATFORM_COMPONENT_GROUP_TEMPLATE'
                </sqlCheck>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="fk_platform_component_group_template_country"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseTableName="platform_component_group_template"
                                 baseColumnNames="platform_country_id"
                                 constraintName="fk_platform_component_group_template_country"
                                 referencedTableName="platform_country"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="platform_component_group_template_locale"
                                 baseColumnNames="platform_component_group_template_id"
                                 constraintName="fk_platform_component_group_template_locale_group"
                                 referencedTableName="platform_component_group_template"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="platform_component_group_template_locale"
                             columnNames="platform_component_group_template_id,locale"
                             constraintName="uk_platform_component_group_template_locale"/>

        <addForeignKeyConstraint baseTableName="platform_component_header_template"
                                 baseColumnNames="platform_component_group_template_id"
                                 constraintName="fk_platform_component_header_template_group"
                                 referencedTableName="platform_component_group_template"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="platform_component_header_template_locale"
                                 baseColumnNames="platform_component_header_template_id"
                                 constraintName="fk_platform_component_header_template_locale_header"
                                 referencedTableName="platform_component_header_template"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="platform_component_header_template_locale"
                             columnNames="platform_component_header_template_id,locale"
                             constraintName="uk_platform_component_header_template_locale"/>

        <addForeignKeyConstraint baseTableName="platform_component_item_template"
                                 baseColumnNames="platform_component_header_template_id"
                                 constraintName="fk_platform_component_item_template_header"
                                 referencedTableName="platform_component_header_template"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="platform_component_item_template"
                                 baseColumnNames="platform_wage_component_id"
                                 constraintName="fk_platform_component_item_template_wage_component"
                                 referencedTableName="platform_wage_component"
                                 referencedColumnNames="id"/>
        <addUniqueConstraint tableName="platform_component_item_template"
                             columnNames="platform_component_header_template_id,platform_wage_component_id"
                             constraintName="uk_platform_component_item_template_header_wage"/>

        <addForeignKeyConstraint baseTableName="platform_component_item_template_locale"
                                 baseColumnNames="platform_component_item_template_id"
                                 constraintName="fk_platform_component_item_template_locale_item"
                                 referencedTableName="platform_component_item_template"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="platform_component_item_template_locale"
                             columnNames="platform_component_item_template_id,locale"
                             constraintName="uk_platform_component_item_template_locale"/>
    </changeSet>

    <!-- Tenant runtime copies (company-scoped), optional link to platform group template. -->
    <changeSet id="schema-m27-tenant-component-group-1" author="wagepayroll">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tenant_component_group"/>
            </not>
        </preConditions>
        <createTable tableName="tenant_component_group">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="platform_component_group_template_id" type="VARCHAR(36)"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="tenant_component_group"
                                 baseColumnNames="platform_component_group_template_id"
                                 constraintName="fk_tenant_component_group_platform_template"
                                 referencedTableName="platform_component_group_template"
                                 referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <createIndex indexName="idx_tenant_component_group_tenant_company" tableName="tenant_component_group">
            <column name="tenant_id"/>
            <column name="company_id"/>
            <column name="active"/>
            <column name="sort_order"/>
        </createIndex>
    </changeSet>

