                </sqlCheck>
            </and>
        </preConditions>
        <dropUniqueConstraint tableName="platform_component_group_locale" constraintName="uk_platform_component_group_locale"/>
        <dropUniqueConstraint tableName="platform_component_header_locale" constraintName="uk_platform_component_header_locale"/>
        <dropUniqueConstraint tableName="platform_component_item" constraintName="uk_platform_component_item_header_wage"/>
        <dropUniqueConstraint tableName="platform_component_item_locale" constraintName="uk_platform_component_item_locale"/>
    </changeSet>

    <changeSet id="schema-m27-rename-tables-platform-component-grouping" author="wagepayroll">
