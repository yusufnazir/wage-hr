<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m58-employee-account-activation-token-1" author="wagepayroll">
        <createTable tableName="employee_account_activation_token">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="user_account_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="token_sha256" type="CHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="expires_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="TIMESTAMP(6)"/>
            <column name="created_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_employee_activation_user"
                                 baseTableName="employee_account_activation_token" baseColumnNames="user_account_id"
                                 referencedTableName="user_account" referencedColumnNames="id"/>
        <createIndex indexName="idx_employee_activation_employee" tableName="employee_account_activation_token">
            <column name="tenant_id"/>
            <column name="employee_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="schema-m58-employee-account-activation-token-2" author="wagepayroll">
        <comment>Align token_sha256 with Hibernate VARCHAR(64) (same as password_reset_token).</comment>
        <modifyDataType tableName="employee_account_activation_token" columnName="token_sha256" newDataType="VARCHAR(64)"/>
    </changeSet>

</databaseChangeLog>
