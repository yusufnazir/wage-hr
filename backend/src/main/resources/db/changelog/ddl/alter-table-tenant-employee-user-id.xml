<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m58-tenant-employee-user-id-1" author="wagepayroll">
        <comment>Link tenant employees to user accounts for self-service login.</comment>
        <addColumn tableName="tenant_employee">
            <column name="user_id" type="VARCHAR(36)"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_tenant_employee_user"
                                 baseTableName="tenant_employee" baseColumnNames="user_id"
                                 referencedTableName="user_account" referencedColumnNames="id"/>
        <createIndex indexName="uidx_tenant_employee_tenant_user" tableName="tenant_employee" unique="true">
            <column name="tenant_id"/>
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
