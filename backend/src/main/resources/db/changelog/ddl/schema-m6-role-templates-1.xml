<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m6-role-templates-1" author="wagepayroll">
        <createTable tableName="role_template">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(32)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="display_name" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="role_template_privilege">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role_template_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="privilege_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="role_template_privilege"
                                 baseColumnNames="role_template_id"
                                 referencedTableName="role_template"
                                 referencedColumnNames="id"
                                 constraintName="fk_role_template_privilege_template"/>

        <addForeignKeyConstraint baseTableName="role_template_privilege"
                                 baseColumnNames="privilege_id"
                                 referencedTableName="privilege"
                                 referencedColumnNames="id"
                                 constraintName="fk_role_template_privilege_privilege"/>

        <addUniqueConstraint tableName="role_template_privilege"
                             columnNames="role_template_id, privilege_id"
                             constraintName="uq_role_template_privilege_unique"/>
    </changeSet>

</databaseChangeLog>

