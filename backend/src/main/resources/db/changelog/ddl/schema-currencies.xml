<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m7-platform-currency-1" author="wagepayroll">
        <createTable tableName="platform_currency">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(3)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="display_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="schema-m7-tenant-currency-1" author="wagepayroll">
        <createTable tableName="tenant_currency">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="platform_currency_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="tenant_currency" baseColumnNames="tenant_id"
                                 constraintName="fk_tenant_currency_tenant"
                                 referencedTableName="tenant" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="tenant_currency" baseColumnNames="platform_currency_id"
                                 constraintName="fk_tenant_currency_platform_currency"
                                 referencedTableName="platform_currency" referencedColumnNames="id"/>
        <addUniqueConstraint tableName="tenant_currency" columnNames="tenant_id,platform_currency_id"
                             constraintName="uk_tenant_currency_tenant_platform"/>
    </changeSet>

</databaseChangeLog>
