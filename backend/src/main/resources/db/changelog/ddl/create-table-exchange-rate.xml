<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-exchange-rate-tenant-exchange-rate-1" author="wagepayroll">
        <createTable tableName="tenant_exchange_rate">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="from_currency_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="to_currency_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="rate" type="DECIMAL(18,8)">
                <constraints nullable="false"/>
            </column>
            <column name="effective_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_tenant_exchange_rate_tenant"
                                 baseTableName="tenant_exchange_rate" baseColumnNames="tenant_id"
                                 referencedTableName="tenant" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_tenant_exchange_rate_from_currency"
                                 baseTableName="tenant_exchange_rate" baseColumnNames="from_currency_id"
                                 referencedTableName="platform_currency" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_tenant_exchange_rate_to_currency"
                                 baseTableName="tenant_exchange_rate" baseColumnNames="to_currency_id"
                                 referencedTableName="platform_currency" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="schema-exchange-rate-check-constraint-1" author="wagepayroll">
        <sql>ALTER TABLE tenant_exchange_rate ADD CONSTRAINT chk_tenant_exchange_rate_rate_positive CHECK (rate > 0)</sql>
    </changeSet>

    <changeSet id="schema-exchange-rate-idx-pair-date-1" author="wagepayroll">
        <createIndex indexName="uidx_tenant_exchange_rate_pair_date" tableName="tenant_exchange_rate" unique="true">
            <column name="tenant_id"/>
            <column name="from_currency_id"/>
            <column name="to_currency_id"/>
            <column name="effective_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="schema-exchange-rate-idx-tenant-1" author="wagepayroll">
        <createIndex indexName="idx_tenant_exchange_rate_tenant" tableName="tenant_exchange_rate">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
