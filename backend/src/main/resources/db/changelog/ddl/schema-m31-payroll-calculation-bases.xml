    <changeSet id="schema-m31-impact-side-columns-1" author="wagepayroll">
        <addColumn tableName="platform_wage_component">
            <column name="impact_side" type="VARCHAR(20)" defaultValue="EMPLOYEE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="tenant_wage_component">
            <column name="impact_side" type="VARCHAR(20)" defaultValue="EMPLOYEE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
