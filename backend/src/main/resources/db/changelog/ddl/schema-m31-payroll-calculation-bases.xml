        </createTable>
        <addForeignKeyConstraint baseTableName="tenant_wage_component_base_effect"
                                 baseColumnNames="tenant_wage_component_id"
                                 constraintName="fk_twc_base_effect_component"
                                 referencedTableName="tenant_wage_component"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="tenant_wage_component_base_effect"
                                 baseColumnNames="platform_payroll_base_id"
                                 constraintName="fk_twc_base_effect_payroll_base"
                                 referencedTableName="platform_payroll_base"
