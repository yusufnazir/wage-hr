            </column>
            <column name="effect_calculation_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="effect_value" type="DECIMAL(18,6)"/>
            <column name="priority" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="effective_from" type="DATE"/>
            <column name="effective_until" type="DATE"/>
