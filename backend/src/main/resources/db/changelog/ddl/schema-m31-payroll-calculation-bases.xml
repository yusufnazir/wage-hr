            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_wage_component_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="platform_payroll_base_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="effect_direction" type="VARCHAR(20)">
