        </createTable>
        <addForeignKeyConstraint baseTableName="platform_wage_component_base_effect"
                                 baseColumnNames="platform_wage_component_id"
                                 constraintName="fk_pwc_base_effect_component"
                                 referencedTableName="platform_wage_component"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="platform_wage_component_base_effect"
                                 baseColumnNames="platform_payroll_base_id"
