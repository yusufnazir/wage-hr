<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m3-billing-webhook-receipt-resolution-1" author="wagepayroll">
        <addColumn tableName="billing_webhook_receipt">
            <column name="raw_payload" type="CLOB">
                <constraints nullable="true"/>
            </column>
            <column name="event_type" type="VARCHAR(128)">
                <constraints nullable="true"/>
            </column>
            <column name="tenant_resolution_state" type="VARCHAR(40)" defaultValue="UNRESOLVED_INSUFFICIENT_DATA">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_resolution_reason_code" type="VARCHAR(64)">
                <constraints nullable="true"/>
            </column>
            <column name="tenant_resolution_missing_field_path" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="tenant_resolution_resolver_version" type="VARCHAR(64)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
