<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m2-tenant-invitation-pending-dedup-1" author="wagepayroll">
        <addColumn tableName="tenant_invitation">
            <column name="pending_dedup_key" type="VARCHAR(400)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <sql>
            UPDATE tenant_invitation
            SET pending_dedup_key = CONCAT(tenant_id, ':', LOWER(invited_email))
            WHERE status = 'PENDING' AND pending_dedup_key IS NULL;
        </sql>
        <addUniqueConstraint tableName="tenant_invitation" columnNames="pending_dedup_key"
                             constraintName="ux_tenant_invitation_pending_dedup"/>
    </changeSet>
</databaseChangeLog>
