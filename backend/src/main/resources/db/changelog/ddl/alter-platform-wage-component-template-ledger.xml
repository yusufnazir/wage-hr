        <addForeignKeyConstraint constraintName="fk_pwct_credit_platform_ledger_template"
                                 baseTableName="platform_wage_component_template"
                                 baseColumnNames="credit_platform_ledger_template_id"
                                 referencedTableName="platform_ledger_template" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
