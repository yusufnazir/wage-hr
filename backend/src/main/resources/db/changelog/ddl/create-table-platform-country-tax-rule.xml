<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m13-platform-country-tax-rule-1" author="wagepayroll">
        <createTable tableName="platform_country_tax_rule">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="country_code" type="CHAR(2)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_code" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="effective_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="effective_to" type="DATE"/>
            <column name="parameters_json" type="VARCHAR(4000)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="schema-m13-platform-country-tax-rule-uidx-1" author="wagepayroll">
        <addUniqueConstraint tableName="platform_country_tax_rule"
                             columnNames="country_code, rule_code, effective_from"
                             constraintName="uidx_platform_country_tax_rule_natural"/>
    </changeSet>

    <changeSet id="schema-m13-platform-country-tax-rule-idx-country-1" author="wagepayroll">
        <createIndex indexName="idx_platform_country_tax_rule_country" tableName="platform_country_tax_rule">
            <column name="country_code"/>
            <column name="active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
