<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m11-tenant-bank-template-1" author="wagepayroll">
        <createTable tableName="tenant_bank_template">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="platform_bank_template_id" type="VARCHAR(36)"/>
            <column name="country_code" type="CHAR(2)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="bank_name" type="VARCHAR(150)"/>
            <column name="swift_bic" type="VARCHAR(11)"/>
            <column name="bank_code" type="VARCHAR(30)"/>
            <column name="account_number_format" type="VARCHAR(100)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_tenant_bank_template_tenant"
                                 baseTableName="tenant_bank_template" baseColumnNames="tenant_id"
                                 referencedTableName="tenant" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_tenant_bank_template_company"
                                 baseTableName="tenant_bank_template" baseColumnNames="company_id,tenant_id"
                                 referencedTableName="tenant_company" referencedColumnNames="id,tenant_id"/>
        <addForeignKeyConstraint constraintName="fk_tenant_bank_template_platform"
                                 baseTableName="tenant_bank_template" baseColumnNames="platform_bank_template_id"
                                 referencedTableName="platform_bank_template" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="schema-m11-tenant-bank-template-idx-tenant-company-1" author="wagepayroll">
        <createIndex indexName="idx_tenant_bank_template_tenant_company" tableName="tenant_bank_template">
            <column name="tenant_id"/>
            <column name="company_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="schema-m11-tenant-bank-template-idx-tenant-1" author="wagepayroll">
        <createIndex indexName="idx_tenant_bank_template_tenant" tableName="tenant_bank_template">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="schema-m11-tenant-bank-template-idx-company-1" author="wagepayroll">
        <createIndex indexName="idx_tenant_bank_template_company" tableName="tenant_bank_template">
            <column name="company_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
