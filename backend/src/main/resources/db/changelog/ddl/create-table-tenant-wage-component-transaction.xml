<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m13-tenant-wage-component-transaction-1" author="wagepayroll">
        <createTable tableName="tenant_wage_component_transaction">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="pay_period_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="pay_period_run_id" type="VARCHAR(36)"/>
            <column name="tenant_wage_component_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(19,4)"/>
            <column name="rate" type="DECIMAL(19,4)"/>
            <column name="amount" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="manual_override" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="remarks" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_twct_company"
                                 baseTableName="tenant_wage_component_transaction" baseColumnNames="company_id,tenant_id"
                                 referencedTableName="tenant_company" referencedColumnNames="id,tenant_id"/>
        <addForeignKeyConstraint constraintName="fk_twct_employee"
                                 baseTableName="tenant_wage_component_transaction" baseColumnNames="employee_id,company_id,tenant_id"
                                 referencedTableName="tenant_employee" referencedColumnNames="id,company_id,tenant_id"/>
        <addForeignKeyConstraint constraintName="fk_twct_pay_period"
                                 baseTableName="tenant_wage_component_transaction" baseColumnNames="pay_period_id,tenant_id"
                                 referencedTableName="tenant_pay_period" referencedColumnNames="id,tenant_id"/>
        <addForeignKeyConstraint constraintName="fk_twct_pay_period_run"
                                 baseTableName="tenant_wage_component_transaction" baseColumnNames="pay_period_run_id"
                                 referencedTableName="tenant_pay_period_run" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_twct_component"
                                 baseTableName="tenant_wage_component_transaction" baseColumnNames="tenant_wage_component_id"
                                 referencedTableName="tenant_wage_component" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="schema-m13-tenant-wage-component-transaction-idx-1" author="wagepayroll">
        <createIndex indexName="idx_twct_tenant_period_employee" tableName="tenant_wage_component_transaction">
            <column name="tenant_id"/>
            <column name="pay_period_id"/>
            <column name="employee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
