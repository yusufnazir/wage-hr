<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m13-tenant-wage-component-balance-tx-1" author="wagepayroll">
        <createTable tableName="tenant_wage_component_balance_transaction">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="balance_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="change_amount" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="balance_after" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_kind" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="pay_period_run_id" type="VARCHAR(36)"/>
            <column name="remarks" type="VARCHAR(500)"/>
            <column name="occurred_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_twcbt_balance"
                                 baseTableName="tenant_wage_component_balance_transaction" baseColumnNames="balance_id,tenant_id"
                                 referencedTableName="tenant_wage_component_balance" referencedColumnNames="id,tenant_id"/>
        <addForeignKeyConstraint constraintName="fk_twcbt_run"
                                 baseTableName="tenant_wage_component_balance_transaction" baseColumnNames="pay_period_run_id"
                                 referencedTableName="tenant_pay_period_run" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="schema-m13-tenant-wage-component-balance-tx-idx-1" author="wagepayroll">
        <createIndex indexName="idx_twcbt_balance_occurred" tableName="tenant_wage_component_balance_transaction">
            <column name="balance_id"/>
            <column name="occurred_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
