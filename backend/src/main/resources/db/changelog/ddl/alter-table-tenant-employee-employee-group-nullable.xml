<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m56-tenant-employee-employee-group-nullable-1" author="wagepayroll">
        <comment>Employee group is optional at hire time; assign later when groups exist.</comment>
        <dropForeignKeyConstraint baseTableName="tenant_employee" constraintName="fk_tenant_employee_group"/>
        <dropNotNullConstraint tableName="tenant_employee" columnName="employee_group_id" columnDataType="VARCHAR(36)"/>
        <addForeignKeyConstraint constraintName="fk_tenant_employee_group"
                                 baseTableName="tenant_employee" baseColumnNames="employee_group_id,company_id,tenant_id"
                                 referencedTableName="tenant_employee_group" referencedColumnNames="id,company_id,tenant_id"/>
    </changeSet>

</databaseChangeLog>
