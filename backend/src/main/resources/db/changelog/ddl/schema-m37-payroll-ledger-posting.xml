<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m37-tenant-payroll-ledger-posting-1" author="wagepayroll">
        <createTable tableName="tenant_payroll_ledger_posting">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="pay_period_run_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_payroll_result_line_id" type="VARCHAR(36)"/>
            <column name="debit_tenant_ledger_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="credit_tenant_ledger_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="CHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="posting_sequence" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_tplp_run"
                                 baseTableName="tenant_payroll_ledger_posting" baseColumnNames="pay_period_run_id"
                                 referencedTableName="tenant_pay_period_run" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_tplp_result_line"
                                 baseTableName="tenant_payroll_ledger_posting" baseColumnNames="tenant_payroll_result_line_id"
                                 referencedTableName="tenant_payroll_result_line" referencedColumnNames="id"/>
        <createIndex indexName="idx_tplp_run_seq" tableName="tenant_payroll_ledger_posting">
            <column name="pay_period_run_id"/>
            <column name="posting_sequence"/>
        </createIndex>
    </changeSet>

    <changeSet id="schema-m37-tenant-payroll-ledger-posting-uidx-1" author="wagepayroll">
        <addUniqueConstraint tableName="tenant_payroll_ledger_posting"
                             columnNames="pay_period_run_id, tenant_payroll_result_line_id"
                             constraintName="uk_tplp_run_result_line"/>
    </changeSet>

    <changeSet id="schema-m37-balance-tx-run-unique-1" author="wagepayroll">
        <addUniqueConstraint tableName="tenant_wage_component_balance_transaction"
                             columnNames="balance_id, pay_period_run_id"
                             constraintName="uk_twcbt_balance_run"/>
    </changeSet>

</databaseChangeLog>
