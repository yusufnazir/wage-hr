<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Hibernate 6 + ddl-auto=validate expect VARCHAR for @Column(length=64); MariaDB CHAR(64) from earlier DDL fails validation. -->
    <changeSet id="schema-password-reset-token-sha256-varchar-1" author="wagepayroll">
        <modifyDataType tableName="password_reset_token" columnName="token_sha256" newDataType="VARCHAR(64)"/>
    </changeSet>
</databaseChangeLog>
