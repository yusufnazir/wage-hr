<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="schema-m12-tenant-payment-location-1" author="wagepayroll">
        <createTable tableName="tenant_payment_location">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="CHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="bank_template_id" type="VARCHAR(36)"/>
            <column name="account_number" type="VARCHAR(60)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_tenant_payment_location_tenant"
                baseTableName="tenant_payment_location" baseColumnNames="tenant_id"
                referencedTableName="tenant" referencedColumnNames="id"/>

        <addForeignKeyConstraint
                constraintName="fk_tenant_payment_location_company"
                baseTableName="tenant_payment_location" baseColumnNames="company_id,tenant_id"
                referencedTableName="tenant_company" referencedColumnNames="id,tenant_id"/>

        <addForeignKeyConstraint
                constraintName="fk_tenant_payment_location_bank_template"
                baseTableName="tenant_payment_location" baseColumnNames="bank_template_id"
                referencedTableName="tenant_bank_template" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="schema-m12-tenant-payment-location-idx-tenant-company-1" author="wagepayroll">
        <createIndex indexName="idx_tenant_payment_location_tenant_company" tableName="tenant_payment_location">
            <column name="tenant_id"/>
            <column name="company_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="schema-m12-tenant-payment-location-idx-active-1" author="wagepayroll">
        <createIndex indexName="idx_tenant_payment_location_tenant_company_active" tableName="tenant_payment_location">
            <column name="tenant_id"/>
            <column name="company_id"/>
            <column name="active"/>
        </createIndex>
    </changeSet>

    <changeSet id="schema-m12-tenant-payment-location-idx-bank-template-1" author="wagepayroll">
        <createIndex indexName="idx_tenant_payment_location_bank_template" tableName="tenant_payment_location">
            <column name="bank_template_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
