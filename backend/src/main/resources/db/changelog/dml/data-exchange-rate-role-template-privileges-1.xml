<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Grants exchange-rate privileges to the ADMIN role template. Must run AFTER
        data-exchange-rate-privileges-1.xml seeds the EXCHANGE_RATE_* privilege rows.
        Mirrors data-m7-role-template-currency-privileges-1.xml.
    -->

    <changeSet id="data-exchange-rate-rtp-admin-view-1" author="wagepayroll" onValidationFail="MARK_RAN">
        <customChange class="com.wagepayroll.liquibase.task.DataGrantRoleTemplatePrivilege">
            <param name="roleTemplateId" value="60000000-0000-0000-0000-000000000001"/>
            <param name="privilegeCode" value="EXCHANGE_RATE_VIEW"/>
        </customChange>
    </changeSet>
    <changeSet id="data-exchange-rate-rtp-admin-manage-1" author="wagepayroll" onValidationFail="MARK_RAN">
        <customChange class="com.wagepayroll.liquibase.task.DataGrantRoleTemplatePrivilege">
            <param name="roleTemplateId" value="60000000-0000-0000-0000-000000000001"/>
            <param name="privilegeCode" value="EXCHANGE_RATE_MANAGE"/>
        </customChange>
    </changeSet>
</databaseChangeLog>
