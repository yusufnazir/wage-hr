            <column name="created_at" valueDate="2026-01-01T00:00:00"/>
            <column name="updated_at" valueDate="2026-01-01T00:00:00"/>
        </insert>
        <insert tableName="mail_template_locale">
            <column name="id" value="60000000-0000-0000-0000-000000000042"/>
            <column name="mail_template_id" value="60000000-0000-0000-0000-000000000004"/>
            <column name="locale" value="nl"/>
            <column name="subject" value="Uw account voor {{companyName}}"/>
