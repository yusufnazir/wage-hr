            <column name="subject" value="U bent gekoppeld aan {{companyName}}"/>
            <column name="body_html" value="&lt;!DOCTYPE html&gt;&lt;html&gt;&lt;body style=&quot;font-family:system-ui,sans-serif;line-height:1.5&quot;&gt;&lt;h1&gt;Hallo, {{firstName}}&lt;/h1&gt;&lt;p&gt;Uw bestaande account is gekoppeld aan werknemersgegevens bij &lt;strong&gt;{{companyName}}&lt;/strong&gt; ({{tenantHandle}}) met de rol &lt;strong&gt;{{roleName}}&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;Meld u aan met uw bestaande wachtwoord.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;"/>
