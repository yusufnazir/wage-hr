            <column name="created_at" valueDate="2026-01-01T00:00:00"/>
            <column name="updated_at" valueDate="2026-01-01T00:00:00"/>
        </insert>
        <insert tableName="mail_template_locale">
            <column name="id" value="60000000-0000-0000-0000-000000000051"/>
            <column name="mail_template_id" value="60000000-0000-0000-0000-000000000005"/>
            <column name="locale" value="en"/>
            <column name="subject" value="You are linked to {{companyName}}"/>
            <column name="body_html" value="&lt;!DOCTYPE html&gt;&lt;html&gt;&lt;body style=&quot;font-family:system-ui,sans-serif;line-height:1.5&quot;&gt;&lt;h1&gt;Hello, {{firstName}}&lt;/h1&gt;&lt;p&gt;Your existing account has been linked to employee records at &lt;strong&gt;{{companyName}}&lt;/strong&gt; ({{tenantHandle}}) with the &lt;strong&gt;{{roleName}}&lt;/strong&gt; role.&lt;/p&gt;&lt;p&gt;Sign in with your existing password.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;"/>
            <column name="created_at" valueDate="2026-01-01T00:00:00"/>
            <column name="updated_at" valueDate="2026-01-01T00:00:00"/>
        </insert>
        <insert tableName="mail_template_locale">
            <column name="id" value="60000000-0000-0000-0000-000000000052"/>
            <column name="mail_template_id" value="60000000-0000-0000-0000-000000000005"/>
