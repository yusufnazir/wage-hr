    <changeSet id="data-m24-sr-loan-template-legacy-label-1" author="wagepayroll">
        <comment>Align loan repayment template (id 51000000-0000-0000-0000-000000000003) with legacy 740-310 naming for catalog users.</comment>
        <update tableName="platform_wage_component_template">
            <column name="name" value="Loan repayment (template)"/>
            <column name="description"
                    value="Post-tax loan or advance repayment (legacy 740-310); balance-tracked."/>
            <column name="country_rule_key" value="SUR_LOAN_REPAYMENT"/>
            <where>id = '51000000-0000-0000-0000-000000000003'</where>
        </update>
    </changeSet>

