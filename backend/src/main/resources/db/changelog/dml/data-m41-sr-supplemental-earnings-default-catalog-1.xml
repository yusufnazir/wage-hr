            <column name="name" value="Child allowance"/>
        </insert>

        <insert tableName="platform_component_item_template">
            <column name="id" value="54200000-0000-0000-0000-000000000021"/>
            <column name="platform_component_header_template_id" value="54100000-0000-0000-0000-000000000001"/>
            <column name="platform_wage_component_template_id" value="51000000-0000-0000-0000-000000000009"/>
            <column name="sort_order" valueNumeric="7"/>
