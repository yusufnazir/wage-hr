    <!-- P2 Phase B: exchange rate compensation (1055) + wage-tax exclusion (1056). -->
    <changeSet id="data-m46-sr-p2-exchange-rate-tax-rule-1" author="wagepayroll">
        <insert tableName="platform_country_tax_rule">
            <column name="id" value="52000000-0000-0000-0000-000000000012"/>
            <column name="country_code" value="SR"/>
            <column name="rule_code" value="SR_EXCHANGE_RATE_COMPENSATION_MONTH"/>
            <column name="name" value="Suriname exchange rate compensation — monthly exclusion cap"/>
            <column name="effective_from" valueDate="2022-01-01"/>
            <column name="parameters_json"
                    value='{"v":2,"freq":"MONTH","kind":"THRESHOLD_AMOUNT","source":"fiscle-2022","amount":800,"note":"Art. 10 exclusion max SRD 800/month (2022–2026)."}'/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueComputed="NOW()"/>
            <column name="updated_at" valueComputed="NOW()"/>
        </insert>
    </changeSet>

