    <!--
        Backfill badge numbers for the 30 demo employees so the directory view
        displays a stable identifier (e.g. "[1000] Maria Jansen"). Each update
        is its own changeSet so already-applied badges are skipped on re-run.
        Updates use onValidationFail="MARK_RAN" to keep redeploys safe.
    -->

    <changeSet id="data-m21-demo-employee-badge-1000" author="wagepayroll" onValidationFail="MARK_RAN">
        <update tableName="tenant_employee">
            <column name="badge_number" value="1000"/>
            <where>id = '5fa00000-0000-4000-8000-000000000005' AND (badge_number IS NULL OR badge_number = '')</where>
        </update>
    </changeSet>
