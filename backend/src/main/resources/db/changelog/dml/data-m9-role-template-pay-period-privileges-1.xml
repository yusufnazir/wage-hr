<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Grants pay-period privileges to the ADMIN role template. Must run AFTER
        data-m9-pay-period-privileges-1.xml seeds the PAY_PERIOD_* privilege rows.
        Mirrors data-m7-role-template-currency-privileges-1.xml.
    -->

    <changeSet id="data-m9-rtp-admin-pay-period-view-1" author="wagepayroll" onValidationFail="MARK_RAN">
        <customChange class="com.wagepayroll.liquibase.task.DataGrantRoleTemplatePrivilege">
            <param name="roleTemplateId" value="60000000-0000-0000-0000-000000000001"/>
            <param name="privilegeCode" value="PAY_PERIOD_VIEW"/>
        </customChange>
    </changeSet>
    <changeSet id="data-m9-rtp-admin-pay-period-manage-1" author="wagepayroll" onValidationFail="MARK_RAN">
        <customChange class="com.wagepayroll.liquibase.task.DataGrantRoleTemplatePrivilege">
            <param name="roleTemplateId" value="60000000-0000-0000-0000-000000000001"/>
            <param name="privilegeCode" value="PAY_PERIOD_MANAGE"/>
        </customChange>
    </changeSet>
    <changeSet id="data-m9-rtp-admin-pay-period-run-view-1" author="wagepayroll" onValidationFail="MARK_RAN">
        <customChange class="com.wagepayroll.liquibase.task.DataGrantRoleTemplatePrivilege">
            <param name="roleTemplateId" value="60000000-0000-0000-0000-000000000001"/>
            <param name="privilegeCode" value="PAY_PERIOD_RUN_VIEW"/>
        </customChange>
    </changeSet>
    <changeSet id="data-m9-rtp-admin-pay-period-run-manage-1" author="wagepayroll" onValidationFail="MARK_RAN">
        <customChange class="com.wagepayroll.liquibase.task.DataGrantRoleTemplatePrivilege">
            <param name="roleTemplateId" value="60000000-0000-0000-0000-000000000001"/>
            <param name="privilegeCode" value="PAY_PERIOD_RUN_MANAGE"/>
        </customChange>
    </changeSet>
</databaseChangeLog>
