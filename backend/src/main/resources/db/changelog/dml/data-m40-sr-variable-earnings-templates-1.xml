    <!--
      Overtime rate lines (150% / 200% / 300%) plus default-catalog membership for vacation and bonus.
      Intended for fresh installs (run before data-m34 base-effect migration).
    -->
    <changeSet id="data-m40-sr-overtime-rate-templates-1" author="wagepayroll">
        <comment>SR overtime templates 1045–1047 (150%, 200%, 300% of derived hourly rate).</comment>

        <insert tableName="platform_wage_component_template">
            <column name="id" value="51000000-0000-0000-0000-00000000002d"/>
            <column name="country_code" value="SR"/>
            <column name="template_code" value="1045"/>
            <column name="name" value="Overtime 150%"/>
            <column name="description" value="Overtime at 150% of monthly-derived hourly rate (hours × rate × 1.5)."/>
            <column name="definition_defaults_json"
                    value='{"componentType":"EARNING","category":"OVERTIME","netEffect":"ADD_TO_NET","calculationMethod":"FORMULA","defaultFormulaExpression":"transaction.quantity * compensation.hourly_rate * 1.5","phase":"GROSS","processingOrder":1025,"taxableWageTax":true,"taxableSocialSecurity":true,"taxablePension":true,"taxableVacationReserve":false,"roundingStrategy":"HALF_UP"}'/>
            <column name="processing_order_hint" valueNumeric="1025"/>
            <column name="phase_hint" value="GROSS"/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueComputed="NOW()"/>
            <column name="updated_at" valueComputed="NOW()"/>
            <column name="debit_platform_ledger_template_id" value="53100000-0000-0000-0000-000000000001"/>
            <column name="credit_platform_ledger_template_id" value="53100000-0000-0000-0000-000000000022"/>
            <column name="duplicable" valueBoolean="true"/>
            <column name="print_on_payslip" valueBoolean="true"/>
            <column name="auxiliary" valueBoolean="false"/>
            <column name="apply_in_payroll" valueBoolean="true"/>
            <column name="recurrence" value="RECURRENT"/>
            <column name="country_rule_key" value="SUR_OVERTIME"/>
            <column name="platform_country_tax_rule_id" value="52000000-0000-0000-0000-000000000003"/>
        </insert>
