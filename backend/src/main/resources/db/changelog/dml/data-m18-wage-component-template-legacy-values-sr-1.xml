<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Align SR platform wage component templates with legacy semantics (duplicable, payslip, country rule key). -->
    <changeSet id="data-m18-wage-component-template-legacy-values-sr-1" author="wagepayroll">
        <update tableName="platform_wage_component_template">
            <column name="duplicable" valueBoolean="false"/>
            <column name="print_on_payslip" valueBoolean="true"/>
            <column name="auxiliary" valueBoolean="false"/>
            <column name="apply_in_payroll" valueBoolean="true"/>
            <column name="recurrence" value="RECURRENT"/>
            <column name="country_rule_key" value="SUR_NORMAL_WAGE"/>
            <column name="platform_country_tax_rule_id" value="52000000-0000-0000-0000-000000000001"/>
            <where>id = '51000000-0000-0000-0000-000000000001'</where>
        </update>
        <update tableName="platform_wage_component_template">
            <column name="duplicable" valueBoolean="true"/>
            <column name="print_on_payslip" valueBoolean="true"/>
            <column name="auxiliary" valueBoolean="false"/>
            <column name="apply_in_payroll" valueBoolean="true"/>
            <column name="recurrence" value="RECURRENT"/>
            <column name="country_rule_key" value="SUR_OVERTIME"/>
            <where>id = '51000000-0000-0000-0000-000000000002'</where>
        </update>
        <update tableName="platform_wage_component_template">
            <column name="duplicable" valueBoolean="true"/>
            <column name="print_on_payslip" valueBoolean="true"/>
            <column name="auxiliary" valueBoolean="false"/>
            <column name="apply_in_payroll" valueBoolean="true"/>
            <column name="recurrence" value="RECURRENT"/>
            <where>id = '51000000-0000-0000-0000-000000000003'</where>
        </update>
    </changeSet>

</databaseChangeLog>
