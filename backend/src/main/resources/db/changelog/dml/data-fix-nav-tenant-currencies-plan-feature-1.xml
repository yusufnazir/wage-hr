<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="data-fix-nav-tenant-currencies-plan-feature-1" author="wagepayroll">
        <comment>Remove bogus required_plan_feature_code from the tenant-currencies nav item.
            The TENANT_CURRENCIES plan feature code was never seeded and does not exist,
            causing the /app/tenant-currencies nav item to be permanently hidden.</comment>
        <update tableName="nav_menu_item">
            <column name="required_plan_feature_code" value=""/>
            <where>id = '50000000-0000-0000-0000-000000000006'</where>
        </update>
    </changeSet>

</databaseChangeLog>
