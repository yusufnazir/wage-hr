    <!--
        Demo compensation rows. Maria (1000) uses PER_HOUR to mirror the
        reference screenshot; everyone else gets PER_PERIOD so the rates table
        has variety. All rows reference the Standard 40h work time
        (5fa00000-0000-4000-8000-000000000007) and SRD currency. The seeding
        task is keyed by employee_id, so re-running is idempotent.

        Compensation row IDs: 5fa00000-0000-4000-8000-000000000200..00000000021d
    -->

    <changeSet id="data-m22-demo-employee-compensation-1000" author="wagepayroll" onValidationFail="MARK_RAN">
        <customChange class="com.wagepayroll.liquibase.task.DataUpsertTenantEmployeeCompensation">
            <param name="id" value="5fa00000-0000-4000-8000-000000000200"/>
            <param name="tenantId" value="10000000-0000-0000-0000-000000000001"/>
            <param name="companyId" value="5fa00000-0000-4000-8000-000000000001"/>
            <param name="employeeId" value="5fa00000-0000-4000-8000-000000000005"/>
            <param name="currencyCode" value="SRD"/>
            <param name="wageType" value="PER_HOUR"/>
            <param name="wageAmount" value="100.00"/>
            <param name="workTimeId" value="5fa00000-0000-4000-8000-000000000007"/>
            <param name="applyTaxes" value="true"/>
            <param name="applyTaxExempt" value="false"/>
            <param name="applyAov" value="true"/>
        </customChange>
    </changeSet>

