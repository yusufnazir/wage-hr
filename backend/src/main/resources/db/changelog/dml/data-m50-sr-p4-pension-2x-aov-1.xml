    <!-- P4 Phase E: pension scheme payout (1064) + wage-tax 2× AOV exclusion (1065). -->
    <changeSet id="data-m50-sr-p4-aov-beneficiary-tax-rules-1" author="wagepayroll">
        <insert tableName="platform_country_tax_rule">
            <column name="id" value="52000000-0000-0000-0000-000000000017"/>
            <column name="country_code" value="SR"/>
            <column name="rule_code" value="SR_AOV_BENEFICIARY_MONTH"/>
            <column name="name" value="Suriname AOV beneficiary monthly amount (2024–Feb 2025)"/>
            <column name="effective_from" valueDate="2024-01-01"/>
            <column name="parameters_json"
                    value='{"v":2,"freq":"MONTH","kind":"THRESHOLD_AMOUNT","source":"fiscle-2024","amount":1750,"note":"Monthly AOV payout to beneficiaries; pension exclusion cap = 2× this amount."}'/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueComputed="NOW()"/>
            <column name="updated_at" valueComputed="NOW()"/>
        </insert>
        <insert tableName="platform_country_tax_rule">
            <column name="id" value="52000000-0000-0000-0000-000000000018"/>
            <column name="country_code" value="SR"/>
            <column name="rule_code" value="SR_AOV_BENEFICIARY_MONTH"/>
            <column name="name" value="Suriname AOV beneficiary monthly amount (from Mar 2025)"/>
            <column name="effective_from" valueDate="2025-03-01"/>
            <column name="parameters_json"
                    value='{"v":2,"freq":"MONTH","kind":"THRESHOLD_AMOUNT","source":"fiscle-2025","amount":2250,"note":"Monthly AOV payout; pension exclusion cap = 2× = SRD 4500/month."}'/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueComputed="NOW()"/>
            <column name="updated_at" valueComputed="NOW()"/>
        </insert>
    </changeSet>

    <changeSet id="data-m50-sr-p4-pension-templates-1" author="wagepayroll">
