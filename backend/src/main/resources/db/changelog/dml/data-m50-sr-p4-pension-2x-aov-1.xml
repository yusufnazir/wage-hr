            <column name="template_code" value="1064"/>
            <column name="name" value="Pension scheme payout"/>
            <column name="description" value="Art. 10(k) pension-scheme payout (employer-entered period amount)."/>
            <column name="definition_defaults_json"
                    value='{"componentType":"EARNING","category":"ALLOWANCE","netEffect":"ADD_TO_NET","calculationMethod":"FIXED_AMOUNT","phase":"GROSS","processingOrder":1120,"taxableWageTax":true,"taxableSocialSecurity":true,"taxablePension":true,"taxableVacationReserve":false,"roundingStrategy":"HALF_UP"}'/>
            <column name="processing_order_hint" valueNumeric="1120"/>
            <column name="phase_hint" value="GROSS"/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueComputed="NOW()"/>
            <column name="updated_at" valueComputed="NOW()"/>
            <column name="debit_platform_ledger_template_id" value="53100000-0000-0000-0000-000000000004"/>
