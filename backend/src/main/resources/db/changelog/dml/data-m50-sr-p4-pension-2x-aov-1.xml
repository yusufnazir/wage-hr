            <column name="apply_in_payroll" valueBoolean="true"/>
            <column name="recurrence" value="RECURRENT"/>
            <column name="country_rule_key" value="SUR_WAGE_TAX_PENSION_2X_AOV"/>
            <column name="platform_country_tax_rule_id" value="52000000-0000-0000-0000-000000000018"/>
        </insert>
    </changeSet>

